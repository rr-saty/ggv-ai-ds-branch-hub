{
  "name": "GGV AI & DS — Google Calendar to Supabase Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Run Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list",
          "cachedResultName": "Primary Calendar"
        },
        "returnAll": true,
        "timeMin": "={{ $now.minus({ days: 1 }).toISO() }}",
        "timeMax": "={{ $now.plus({ days: 90 }).toISO() }}",
        "options": {
          "orderBy": "startTime"
        }
      },
      "id": "google-calendar",
      "name": "Get Calendar Events (90 Days)",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        420,
        300
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "",
          "name": "CONNECT_GOOGLE_CALENDAR_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const item of items) {\n const e = item.json;\n const summary = String(e.summary || e.title || '').trim();\n const id = String(e.id || '').trim();\n if (!id || !summary) continue;\n const start = e.start?.dateTime || (e.start?.date ? e.start.date + 'T00:00:00+05:30' : e.startTime);\n const end = e.end?.dateTime || (e.end?.date ? e.end.date + 'T23:59:00+05:30' : e.endTime);\n if (!start || !end) continue;\n const isDeadline = /^\\\\[DEADLINE\\\\]/i.test(summary);\n const title = summary.replace(/^\\\\[DEADLINE\\\\]\\\\s*/i, '').slice(0,160);\n const description = String(e.description || '').slice(0,5000);\n const common = { external_id:id, external_source:'google_calendar', source:'external_sync', updated_at:new Date().toISOString() };\n if (isDeadline) out.push({json:{table:'deadlines',row:{...common,title,description,due_at:start,status:'upcoming',url:e.htmlLink || null}}});\n else out.push({json:{table:'schedules',row:{...common,title,course_code:null,faculty_name:null,room:e.location || null,starts_at:start,ends_at:end,recurrence_rule:null}}});\n}\nreturn out;"
      },
      "id": "normalize-events",
      "name": "Normalize Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "deadline-table",
              "leftValue": "={{ $json.table }}",
              "rightValue": "deadlines",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "route-type",
      "name": "Deadline or Schedule?",
